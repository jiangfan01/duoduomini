<scroll-view scroll-y class="box">
    <view class="items">
        <view class="item" wx:for="{{allOrders}}" wx:key="index">
            <view class="item-order-number">订单号：{{item.orderNumber}}</view>
            <view class="item-content">
                <view class="item-img">
                    <image src="/images/demo/test.jpg"></image>
                </view>
                <view class="item-info">
                    <view class="item-title">{{item.title}}</view>
                    <view class="item-tag">{{item.tag}}</view>
                    <view class="item-price">￥{{item.price}}</view>
                    <view class="item-action" wx:if="{{item.status === '待处理'}}">
                        <view class="status">状态:</view>
                        <view class="status-text-error">{{item.status}}</view>
                    </view>
                    <view class="item-action" wx:else>
                        <view class="status">状态:</view>
                        <view class="status-text-success">{{item.status}}</view>
                    </view>
                    <view class="item-number">x{{item.count}}</view>
                </view>

            </view>
        </view>
    </view>
</scroll-view>