page {
    background: #f8f8f8;
}

.items {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: white;
    padding-bottom: 20px;
}

.item {
    padding: 5px 20px;
    border-bottom: 1px solid #ebebeb;
}

.item-action {
    font-size: 14px;
    display: flex;
    justify-content: flex-end;
    gap: 12px;
}

.status {
    font-size: 16px;
}

.status-text-error {
    background: #e54d42;
    color: white;
    border-radius: 24px;
    padding: 4px 8px;
}

.status-text-success {
    background: #67c1b5;
    color: white;
    border-radius: 24px;
    padding: 4px 8px;
}

.cancel, .goto-pay {
    background-color: #67c1b5;
    color: white;
    border-radius: 24px;
    padding: 4px 12px;
}

.item-order-number {
    font-size: 12px;
    color: #999999;
    margin-bottom: 12px;
}

.item-content {
    display: flex;
    align-items: center;
}

.item-img image {
    width: 120px;
    height: 120px;
}

.item-info {
    margin-left: 12px;
    display: flex;
    gap: 10px;
    flex-direction: column;
}

.item-price {
    color: #e54d42;
}

.item-tag {
    font-size: 12px;
    border-radius: 24px;
    color: #67c1b5;
    border: 1px solid #67c1b5;
    align-self: flex-start;
    padding: 3px 6px;
    text-align: center;
}

.item-number {
    color: #999999;
    align-self: flex-end;
}