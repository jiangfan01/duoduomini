page {
    background: #f8f8f8;
}

.list-box {
    background: white;
    padding: 24px;
}
.list-item {
    display: flex;
    gap: 12px;              /* 设置子元素之间的间距 */
    padding: 12px 0;        /* 内边距 */
    border-bottom: 1px solid #eeeeee;
    align-items: center;    /* 垂直居中 */
}

.item-img {
    flex-shrink: 0;         /* 图片不缩小 */
    width: 80px;            /* 固定图片宽度 */
    height: 80px;           /* 固定图片高度 */
}

.item-img image {
    width: 100%;            /* 图片宽度填满容器 */
    height: 100%;           /* 图片高度填满容器 */
    object-fit: cover;      /* 保持图片比例，裁剪多余部分 */
}

.item-info {
    flex-grow: 1;           /* info 区域占据剩余空间 */
    display: flex;
    flex-direction: column;
    justify-content: space-between;  /* 垂直方向内容分布 */
}

.name {
    font-size: 18px;
    font-weight: 600;
}

.description {
    font-size: 14px;
    color: #999999;
}

.number {
    align-self: flex-end;
    color: #999999;
}

.price-box {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
}

.price {
    font-size: 18px;
    color: #e54d42;
}

.pre-price {
    font-size: 14px;
    color: #999999;
    text-decoration: line-through;
}
.delete{
    align-self: flex-end;
    margin-bottom: 5px;
}
.delete-all{
    margin-left: 20px;
}